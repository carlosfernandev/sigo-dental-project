# Copy to deploy/.env and change every value that says change_me.
# deploy/.env is gitignored; this template is the only versioned copy.
#
#   cp deploy/.env.example deploy/.env
#   openssl rand -base64 24        # generate a password
#
# Compose reads deploy/.env automatically because it sits next to
# docker-compose.yml. Do not commit real credentials anywhere.

COMPOSE_PROJECT_NAME=sigo-dental

# --- PostgreSQL server (used by the postgres container on first init) ---
SIGO_PG_USER=sigo
SIGO_PG_PASSWORD=change_me_before_first_run
SIGO_PG_PORT=5432
# Maintenance database. The monolith uses this database directly.
SIGO_PG_MAINTENANCE_DB=sigo

# --- PostgreSQL client (used by the Go monolith) ---
SIGO_PG_HOST=127.0.0.1
SIGO_PG_DATABASE=sigo
SIGO_PG_SSLMODE=disable
SIGO_PG_MAX_CONNS=10
SIGO_PG_MIN_CONNS=0

# --- Redis ---
SIGO_REDIS_HOST=127.0.0.1
SIGO_REDIS_PORT=6379
SIGO_REDIS_DATABASE=0
# SIGO_REDIS_PASSWORD=

# Local development administrator. The frontend shows these credentials only in Vite dev mode.
# Replace them before using this template outside local development.
SIGO_ADMIN_EMAIL=admin@example.com
SIGO_ADMIN_PASSWORD=clinic-user-password-2026

# --- Service ---
SIGO_ENV=development
SIGO_LOG_LEVEL=debug
# Comma-separated exact frontend origins allowed by the API. Update for deployed frontend URLs.
SIGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Generate a local signing secret with: openssl rand -hex 32
SIGO_JWT_SECRET=change_me_before_first_run
