# Copy to deploy/.env.production and replace every CHANGE_ME value.
COMPOSE_PROJECT_NAME=sigo-dental

SIGO_ENV=production
SIGO_LOG_LEVEL=info
SIGO_CORS_ALLOWED_ORIGINS=https://clinic.example.com
SIGO_JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

SIGO_PG_USER=sigo
SIGO_PG_PASSWORD=CHANGE_ME_long_random_database_password
SIGO_PG_DATABASE=sigo
SIGO_PG_MAX_CONNS=20
SIGO_PG_MIN_CONNS=2

SIGO_ADMIN_EMAIL=admin@clinic.example.com
SIGO_ADMIN_PASSWORD=CHANGE_ME_long_unique_admin_password
